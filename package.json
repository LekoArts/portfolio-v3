{
	"name": "portfolio-v3",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@10.4.1",
	"scripts": {
		"bootstrap": "pnpm install && pnpm playwright:init",
		"dev": "astro dev",
		"build": "astro build",
		"build:e2e": "cross-env IS_PLAYWRIGHT=true astro build",
		"check": "astro sync && astro-check",
		"preview": "astro preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:title-case": "tsx ./scripts/lint-title-case.ts",
		"test:watch": "vitest watch",
		"test": "vitest run",
		"test:e2e": "pnpm build:e2e && pnpm e2e:build",
		"playwright:init": "playwright install chromium",
		"e2e:dev": "cross-env IS_PLAYWRIGHT=true playwright test --ui",
		"e2e:build": "cross-env IS_PLAYWRIGHT=true IS_BUILD=true playwright test",
		"new-post": "tsx ./scripts/writing.ts"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "0.4.10",
		"@astrojs/mdx": "8.1.6",
		"@astrojs/netlify": "8.2.14",
		"@astrojs/react": "7.1.9",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.6",
		"@codesandbox/sandpack-react": "^2.20.0",
		"@expressive-code/plugin-collapsible-sections": "0.44.4",
		"@expressive-code/plugin-line-numbers": "0.44.4",
		"@lekoarts/satteri-sandpack": "1.1.0",
		"@nanostores/persistent": "^1.3.5",
		"@nanostores/react": "^2.0.1",
		"@unpic/core": "1.0.3",
		"@vanilla-extract/css": "^1.21.3",
		"@vanilla-extract/sprinkles": "^1.7.1",
		"astro": "7.4.13",
		"astro-expressive-code": "0.44.4",
		"culori": "^4.0.2",
		"lodash-es": "^4.18.1",
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-to-string": "^4.0.0",
		"nanoid": "^6.0.2",
		"nanostores": "^1.5.5",
		"query-string": "^10.0.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"reading-time": "^1.5.0",
		"satteri": "0.11.7",
		"sharp": "^0.35.5",
		"typescript": "^6.0.3",
		"unpic": "4.2.2"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^10.0.0",
		"@astrojs/check": "0.9.12",
		"@clack/prompts": "^1.9.0",
		"@netlify/edge-functions": "^4.0.4",
		"@playwright/test": "^1.65.1",
		"@sindresorhus/slugify": "^4.0.1",
		"@types/culori": "^4.0.1",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vanilla-extract/private": "^1.0.9",
		"@vanilla-extract/vite-plugin": "5.2.6",
		"astro-eslint-parser": "^3.2.0",
		"cross-env": "^10.1.0",
		"csstype": "^3.2.4",
		"eslint": "^10.15.0",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-format": "^2.0.1",
		"prettier-plugin-astro": "^1.1.2",
		"tsx": "^4.23.15",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "5.1.1"
	}
}
