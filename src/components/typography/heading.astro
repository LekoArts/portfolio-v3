---
import { type Headings, headingVariants } from '@styles/typography.css'
import Box, { type BoxProps } from '@components/primitives/box.astro'

interface Props extends BoxProps<Headings> {
	as: Headings
	/**
	 * Visual size, when it should differ from the semantic level
	 */
	size?: Headings
}

const { as, size = as, class: className, ...rest } = Astro.props
---

<Box as={as} class:list={[headingVariants[size], className]} {...rest}>
	<slot />
</Box>
