---
import Box from '@components/primitives/box.astro'
import { groupStyle, marginBottomVariants, playPauseButtonStyle, playPauseIconStyle, videoStyle } from './video.css'
import { SITE } from '@constants/meta'
import SvgIcon from '@components/primitives/svg-icon.astro'

type Props = {
	src: string
	ariaLabel: string
	description?: string
	maxWidth?: string
}

const { src, ariaLabel, description, maxWidth = '100%' } = Astro.props

const ICON_SIZE = `30px`
const MB_VARIANT = description ? `withDescription` : `default`
---

<figure data-testid="video">
	<lekoarts-video>
		<Box position="relative" m="auto" style={{ maxWidth }} class={groupStyle}>
			<Box
				as="video"
				position="relative"
				display="block"
				m="auto"
				playsinline
				loop
				muted
				preload="none"
				aria-label={ariaLabel}
				class:list={[videoStyle, marginBottomVariants[MB_VARIANT]]}
			>
				<source src={src} type="video/mp4" />
				<p>
					Your browser doesn't support HTML5 video. Here is a <a href={`${SITE.url}${src}`}>link to the video</a>{' '}
					instead.
				</p>
			</Box>
			<button type="button" class={playPauseButtonStyle} aria-label="Pause video" data-paused="false">
				<span class={playPauseIconStyle}>
					<SvgIcon id="pause" width={ICON_SIZE} height={ICON_SIZE} style={{ strokeWidth: `2px` }} />
				</span>
			</button>
		</Box>
	</lekoarts-video>
	<figcaption>{description}</figcaption>
</figure>

<template id="video-icons">
	<SvgIcon id="pause" width={ICON_SIZE} height={ICON_SIZE} style={{ strokeWidth: `2px` }} class="pause" />
	<SvgIcon
		id="play"
		width={ICON_SIZE}
		height={ICON_SIZE}
		style={{ marginLeft: `5px`, strokeWidth: `2px` }}
		class="play"
	/>
</template>

<script>
	class LekoArtsVideo extends HTMLElement {
		constructor() {
			super()

			const video = this.querySelector('video') as HTMLVideoElement
			const button = this.querySelector('button') as HTMLButtonElement
			const template = document.querySelector('#video-icons') as HTMLTemplateElement

			// The button reflects the real playback state, so a blocked autoplay never shows a stale icon
			const sync = () => {
				const icon = video.paused ? 'play' : 'pause'
				const newIcon = template.content.querySelector(`.${icon}`) as SVGElement
				const oldIcon = button.querySelector('svg') as SVGElement

				oldIcon.replaceWith(newIcon.cloneNode(true))
				button.dataset.paused = String(video.paused)
				button.setAttribute('aria-label', video.paused ? 'Play video' : 'Pause video')
			}

			video.addEventListener('play', sync)
			video.addEventListener('pause', sync)

			button.addEventListener('click', () => {
				if (video.paused) {
					video.play()
					// eslint-disable-next-line style/brace-style
				} else {
					video.pause()
				}
			})

			// Respect reduced motion: only autoplay when the visitor hasn't asked for less motion
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				video.play().catch(sync)
				// eslint-disable-next-line style/brace-style
			} else {
				// Load enough to show the first frame while paused
				video.preload = 'metadata'
				sync()
			}
		}
	}

	customElements.define('lekoarts-video', LekoArtsVideo)
</script>
