---
import type { Tag } from '@constants/types'
import { tagCloseIconStyle, tagGroupStyle, tagStyle } from './tag-group.css'
import SvgIcon from '@components/primitives/svg-icon.astro'

type Props =
	| {
			id: 'writing'
			items: Array<Tag>
	  }
	| {
			id: 'photos'
			items: Array<string>
	  }

const { id, items } = Astro.props
---

<lekoarts-tag-group data-id={id}>
	<div class={tagGroupStyle}>
		{items.sort().map((item) => (
			<button class={tagStyle} data-item={item} aria-pressed="false">
				{item}
				<span class={tagCloseIconStyle} aria-hidden="true">
					<SvgIcon id="close" width="100%" height="100%" />
				</span>
			</button>
		))}
	</div>
</lekoarts-tag-group>

<script>
	import type { Tag } from '@constants/types'
	import type { TagGroupKeys } from '@stores/tag-group'
	import { $tagGroup, addTag, removeTag } from '@stores/tag-group'
	import { queryStringTags } from '@utils/url'
	import { listenKeys } from 'nanostores'

	class LekoArtsTagGroup extends HTMLElement {
		id: TagGroupKeys
		itemSelector: string
		buttons: NodeListOf<HTMLButtonElement>
		/**
		 * Set while restoring state from the URL so that Back/Forward doesn't push new history entries
		 */
		isRestoring: boolean

		constructor() {
			super()

			this.id = this.dataset.id as TagGroupKeys
			this.itemSelector = '.tag-group-item'
			this.buttons = this.querySelectorAll('button')
			this.isRestoring = false

			this.restoreFromUrl()

			this.buttons.forEach((button) => {
				button.addEventListener('click', () => {
					const item = button.dataset.item as string

					if ($tagGroup.get()[this.id].includes(item)) {
						removeTag(this.id, item)
						// eslint-disable-next-line style/brace-style
					} else {
						addTag(this.id, item)
					}
				})
			})

			listenKeys($tagGroup, [this.id], ({ [this.id]: selectedTags }) => {
				this.render(selectedTags)

				if (!this.isRestoring) {
					let search = ''
					if (selectedTags.length > 0) {
						search = `?${queryStringTags.to({ tags: selectedTags })}`
					}
					window.history.pushState({}, '', `${window.location.pathname}${search}`)
				}
			})

			window.addEventListener('popstate', () => {
				this.isRestoring = true
				this.restoreFromUrl()
				this.isRestoring = false
			})
		}

		/**
		 * Read tags from the query params (?tags=MDX,Astro) into the store and update the UI
		 */
		restoreFromUrl() {
			const parsed = queryStringTags.from(window.location.search)
			const tags = (parsed?.tags ?? []) as Array<Tag>

			$tagGroup.setKey(this.id, tags)
			this.render(tags)
		}

		render(selectedTags: Array<string>) {
			this.buttons.forEach((button) => {
				const isActive = selectedTags.includes(button.dataset.item as string)

				button.classList.toggle('active', isActive)
				button.setAttribute('aria-pressed', String(isActive))
			})

			document.querySelectorAll<HTMLElement>(this.itemSelector).forEach((item) => {
				const tags = item.dataset.tags?.split(',') || []
				const isVisible = selectedTags.length === 0 || tags.some((tag) => selectedTags.includes(tag))

				item.classList.toggle('hidden', !isVisible)
			})
		}
	}

	customElements.define('lekoarts-tag-group', LekoArtsTagGroup)
</script>
